{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/join/(.*)",
      "dest": "/"
    },
    {
      "src": "/sankalp/(.*)",
      "dest": "/"
    },
    {
      "src": "/calendar/(.*)",
      "dest": "/"
    }
  ]
}
